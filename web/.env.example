# Copy to .env.local (git-ignored) and fill in. Nothing secret belongs here.
# Address of the deployed Gavel contract on Monad testnet (printed by the deploy script).
NEXT_PUBLIC_GAVEL_ADDRESS=

# Photo uploads (optional). Added automatically on Vercel when a Blob store is connected
# (Project → Storage → Blob). For local dev run `vercel env pull .env.local`.
# Server-only secret: never rename it with a NEXT_PUBLIC_ prefix.
# BLOB_READ_WRITE_TOKEN=
